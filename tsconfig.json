{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["plugins/*/src/**/*.ts", "plugins/*/src/**/*.tsx", "apps/mock-seat/src/**/*.ts", "apps/sandbox-manager/src/**/*.ts"]
}
